# Versioning is handled by GitHub Releases.
module(name = "score_docs_as_code")

# For bzl-unittests
bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)

###############################################################################
#
# Python version
#
###############################################################################
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "platforms", version = "1.0.0")

DEFAULT_PYTHON_VERSION = "3.12"

ADDITIONAL_PYTHON_VERSION = "3.14"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = DEFAULT_PYTHON_VERSION,
)

# Keep the default toolchain on DEFAULT_PYTHON_VERSION so existing consumers continue
# to get the established build environment. Register other supported versions
# as non-default toolchains; CI and users can select them with rules_python's
# python_version build setting.
python.toolchain(
    configure_coverage_tool = True,
    is_default = False,
    python_version = ADDITIONAL_PYTHON_VERSION,
)

###############################################################################
#
# docs dependencies (Sphinx)
#
###############################################################################
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    envsubst = ["PIP_INDEX_URL"],
    extra_pip_args = ["--index-url=${PIP_INDEX_URL:-https://pypi.org/simple/}"],
    hub_name = "docs_as_code_hub_env",
    python_version = DEFAULT_PYTHON_VERSION,
    requirements_lock = "//src:requirements.txt",
)
pip.parse(
    envsubst = ["PIP_INDEX_URL"],
    extra_pip_args = ["--index-url=${PIP_INDEX_URL:-https://pypi.org/simple/}"],
    hub_name = "docs_as_code_hub_env",
    python_version = ADDITIONAL_PYTHON_VERSION,
    requirements_lock = "//src:requirements_py314.txt",
)
use_repo(pip, "docs_as_code_hub_env")

register_toolchains(
    "//src:_plantuml_toolchain_linux_amd64",
    "//src:_plantuml_toolchain_linux_arm64",
    "//src:_plantuml_toolchain_macos_arm64",
    "//src:_plantuml_toolchain_windows_amd64",
)

# Additional Python rules provided by aspect, e.g. an improved version of
bazel_dep(name = "aspect_rules_py", version = "1.4.0")
bazel_dep(name = "score_tools", version = "0.0.4")

# PlantUML native distributions. Bazel toolchain resolution chooses the archive
# matching the execution platform.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "plantuml_native_linux_amd64",
    urls = ["https://github.com/plantuml/plantuml/releases/download/v1.2026.9/native-plantuml-linux-amd64-1.2026.9.zip"],
    sha256 = "4bf6d1a3efee62e5e42a4f950ac4b6c11c6455a37fc1a0f784fb5867ca8c2ff0",
    build_file_content = """
package(default_visibility = [\"//visibility:public\"])
filegroup(name = \"runtime\", srcs = glob([\"**\"]))
exports_files([\"plantuml\"])
""",
)

