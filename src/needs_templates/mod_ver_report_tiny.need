   .. grid-item::

      .. needpie:: {{ component_title }} Architecture Elements Status
         :labels: valid, invalid
         :colors: #37a12d, #ca2828
         :legend:

         type in ["comp_arc_sta", "comp_arc_dyn"] and "{{ component_id }}" in belongs_to and status == "valid"
         type in ["comp_arc_sta", "comp_arc_dyn"] and "{{ component_id }}" in belongs_to and status == "invalid"

