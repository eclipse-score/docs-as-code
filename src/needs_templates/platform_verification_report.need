{#
  score: render-after-needs-collection

  Content template for the ``document`` need type for ``platform_verification_report``.

  Unlike ``module_verification_report``, this report is not scoped to a single
  module: it collects every Feature in the current build's Need graph via the
  ``needs_of_type`` helper, so it always reflects the full platform surface
  regardless of which document instantiates it. This is the platform-wide,
  feature-scoped counterpart to ``module_verification_report``'s
  module-and-component-scoped report.

  The template is applied as ``:post_template:``, not ``:template:``. A need's
  *content* cannot open new sections ("Unexpected section title"), but
  post-content is placed after the need at document level, where real headings
  work — and real headings are what give the report its TOC entries and
  per-feature navigation.
#}
{# Unset/empty ``report_version`` keeps the report unscoped (all Features and
   requirements shown), which is what the "_latest" report relies on. #}
{% set report_version = report_version|default(None, true) %}
{#- A Feature with no requirement in scope is dropped from the report
    entirely instead of rendering an empty section. -#}
{% set ns_features = namespace(list=[]) %}
{% for feature in needs_of_type("feat")|unique(attribute="id")|sort(attribute="title")|list %}
{% set feature_reqs = linked_needs(feature["id"], "satisfied_by_back")|selectattr("type", "eq", "feat_req")|list %}
{% if any_req_in_report_version(feature_reqs, report_version) %}
{% set ns_features.list = ns_features.list + [feature] %}
{% endif %}
{% endfor %}
{% set report_features = ns_features.list %}

{% set feature_workproducts = [
     ["wp__requirements_inspect", "Requirements Inspection"],
     ["wp__sw_arch_verification", "Architecture Inspection"],
     ["wp__feature_dfa", "DFA"],
     ["wp__feature_fmea", "FMEA"],
   ] %}

{#- ``workproduct_rows``, ``id_filter_list`` and ``safety_pie_row`` are render
    helpers shared with the module report. -#}
{#- Stakeholder requirements are not scoped to a Feature, so they are
    collected once for the whole report rather than per-Feature like
    ``feat_req``. -#}
{% set ns_stkh_reqs = namespace(list=[]) %}
{% for req in needs_of_type("stkh_req")|unique(attribute="id")|list %}
{% if req_in_report_version(req, report_version) %}
{% set ns_stkh_reqs.list = ns_stkh_reqs.list + [req] %}
{% endif %}
{% endfor %}
{% set stkh_req_ids = ns_stkh_reqs.list|map(attribute="id")|list %}
{% set stkh_req_filter = 'id in ' ~ id_filter_list(stkh_req_ids) %}
.. raw:: html

   <style>
   .wp-doc-table td .needstable_wrapper,
   .wp-doc-table td .pst-scrollable-table-container {
       margin: 0; padding: 0; overflow: visible;
   }
   .wp-doc-table td table.NEEDS_TABLE,
   .wp-doc-table td table.NEEDS_DATATABLES {
       border: 0; margin: 0; box-shadow: none; background: transparent;
       width: auto;
   }
   .wp-doc-table td table.NEEDS_TABLE thead,
   .wp-doc-table td table.NEEDS_DATATABLES thead { display: none; }
   .wp-doc-table td table.NEEDS_TABLE tbody tr,
   .wp-doc-table td table.NEEDS_DATATABLES tbody tr { background: transparent; }
   .wp-doc-table td table.NEEDS_TABLE tbody td,
   .wp-doc-table td table.NEEDS_DATATABLES tbody td {
       border: 0; padding: 0; background: transparent;
   }
   .wp-doc-table td .dataTables_wrapper .dataTables_length,
   .wp-doc-table td .dataTables_wrapper .dataTables_filter,
   .wp-doc-table td .dataTables_wrapper .dataTables_info,
   .wp-doc-table td .dataTables_wrapper .dataTables_paginate { display: none; }
   /* Scales every chart to its column; together with the fixed three-column
      raster this gives every chart in the report the same size. */
   .score-pie-row img.score-report-pie {
       width: 100%;
       height: auto;
   }
   /* ``.sd-row`` is a flex container without a justification of its own, so
      this centres the rows that leave the third column empty. */
   .score-pie-row { justify-content: center; }

   p.rubric.safety-class-heading {
       display: inline-block; margin: 1.4em 0 0.5em 0;
       padding: 0.15em 0.9em; border-radius: 1em;
       font-size: 0.95em; font-weight: 600; color: #ffffff;
   }
   p.rubric.safety-class-heading.safety-asil-b { background: #1f4e79; }
   p.rubric.safety-class-heading.safety-qm { background: #6c757d; }

   /* Stands in for a whole pie row of a safety class without any Need. */
   .empty-pie {
       padding: 0.2em 0.8em; margin-bottom: 0.5em;
       border: 2px dashed #b0b0b0; border-radius: 6px;
       color: #6c757d; font-style: italic;
   }

   .chart-legend { display: flex; flex-wrap: wrap; gap: 1.2em 2.5em; }
   .chart-legend-group {
       display: flex; flex-direction: column; gap: 0.3em;
       flex: 1 1 20em; font-size: 0.9em;
   }
   .chart-legend-head { font-weight: 600; }
   .chart-legend-dot {
       display: inline-block; width: 0.8em; height: 0.8em;
       margin-right: 0.5em; border-radius: 50%;
       border: 1px solid rgba(0, 0, 0, 0.25);
   }
   </style>

.. dropdown:: Legend — status values and chart colours
   :animate: fade-in
   :open:

   .. raw:: html

      <div class="chart-legend">
        <div class="chart-legend-group">
          <span class="chart-legend-head">Status — ASIL B</span>
          <span><span class="chart-legend-dot" style="background: #37a12d;"></span><code>valid_inspected</code> — agreed and formally inspected</span>
          <span><span class="chart-legend-dot" style="background: #f5c518;"></span><code>valid</code> — agreed, formal inspection still outstanding</span>
          <span><span class="chart-legend-dot" style="background: #ca2828;"></span><code>invalid</code> — not agreed; metamodel checks are skipped</span>
        </div>
        <div class="chart-legend-group">
          <span class="chart-legend-head">Status — QM</span>
          <span><span class="chart-legend-dot" style="background: #37a12d;"></span><code>valid</code> — agreed; QM needs are not formally inspected, so this is their final state (<code>valid_inspected</code> counts here too)</span>
          <span><span class="chart-legend-dot" style="background: #ca2828;"></span><code>invalid</code> — not agreed; metamodel checks are skipped</span>
        </div>
        <div class="chart-legend-group">
          <span class="chart-legend-head">Test coverage — both classes</span>
          <span><span class="chart-legend-dot" style="background: #37a12d;"></span>fully covered — at least one test fully verifies the need</span>
          <span><span class="chart-legend-dot" style="background: #f0a500;"></span>partially covered — only partially verifying tests</span>
          <span><span class="chart-legend-dot" style="background: #ca2828;"></span>not covered — no verifying test at all</span>
        </div>
        <div class="chart-legend-group">
          <span class="chart-legend-head">Reference coverage — both classes</span>
          <span><span class="chart-legend-dot" style="background: #37a12d;"></span>referenced by lower — a requirement one level down derives from it</span>
          <span><span class="chart-legend-dot" style="background: #ca2828;"></span>not referenced — nothing on the level below derives from it</span>
        </div>
      </div>

{# ===================================================================== #}
{# Stakeholder Requirements                                               #}
{# ===================================================================== #}

Stakeholder Requirements
------------------------

{#- Reference coverage: a stakeholder requirement is "referenced" when at least
    one in-scope feature requirement is ``derived_from`` it. The index is built
    and applied in Python, because every ``in`` test evaluated here would cross
    the Rust/Python boundary once per comparison. -#}
{% set stkh_referenced_ids = referenced_ids("feat_req", "derived_from", report_version) %}
{% set ns_stkh_ref = split_by_reference(stkh_req_ids, stkh_referenced_ids) %}
{% set stkh_base = 'type == "stkh_req" and ' ~ stkh_req_filter %}
{% set stkh_asil = ns_stkh_reqs.list|selectattr("safety", "eq", "ASIL_B")|list %}
{% set stkh_qm = ns_stkh_reqs.list|selectattr("safety", "eq", "QM")|list %}
{% set stkh_asil_ref = split_by_reference(stkh_asil|map(attribute="id")|list, stkh_referenced_ids) %}
{% set stkh_qm_ref = split_by_reference(stkh_qm|map(attribute="id")|list, stkh_referenced_ids) %}
{{ safety_pie_row("", "Stakeholder Requirements", stkh_base, "ASIL_B", "ASIL B",
     stkh_asil|length, true, stkh_asil_ref.referenced, stkh_asil_ref.missing) }}
{{ safety_pie_row("", "Stakeholder Requirements", stkh_base, "QM", "QM",
     stkh_qm|length, true, stkh_qm_ref.referenced, stkh_qm_ref.missing) }}

.. dropdown:: Show requirements table
   :animate: fade-in

   .. needtable::
      :filter: type == "stkh_req" and {{ stkh_req_filter }}
      :style: table
      :columns: id;title;safety;status;testlink
      :colwidths: 13,22,8,10,47
      :sort: safety
{% if ns_stkh_ref.missing %}
{#- Detail view of the "not referenced" slices of the reference coverage pies
    above; both are rendered from the same in-scope ID list. -#}

.. dropdown:: Not referenced by feature requirements ({{ ns_stkh_ref.missing|length }})
   :animate: fade-in
   :color: warning

   .. needtable::
      :filter: id in {{ id_filter_list(ns_stkh_ref.missing) }}
      :style: table
      :columns: id;title;safety;status
      :colwidths: 15,45,15,25
      :sort: safety
{% endif %}

{# ===================================================================== #}
{# Features                                                               #}
{# ===================================================================== #}

Features
--------

Feature Overview
~~~~~~~~~~~~~~~~

.. needtable::
   :filter: id in [{% for feature in report_features %}"{{ feature["id"] }}"{% if not loop.last %}, {% endif %}{% endfor %}]
   :columns: id as "Feature";safety;security;status
   :style: table
   :sort: safety

{#- Reference coverage index, built once for all Features: a feature
    requirement is "referenced" when at least one in-scope component
    requirement is ``derived_from`` it. -#}
{% set comp_referenced_ids = referenced_ids("comp_req", "derived_from", report_version) %}
{% for feature in report_features %}
{% set feature_id = feature["id"] %}
{% set feature_title = feature["title"] %}
{# The feature Need supplies the work-product document selector and the
   navigation anchor, the same way components do in module_verification_report. #}
{% set feature_slug_norm = feature_title|replace("_", "")|replace(" ", "")|lower %}
{% set feature_anchor = feature_title|replace("_", "-")|replace(" ", "-")|lower %}

.. _feat-{{ feature_anchor }}:

{{ feature_title }}
{{ "~" * (feature_title|length) }}

.. raw:: html

   <hr style="border-top: 2px solid #333333; margin: 0.5em 0 1.5em 0;">

{% set feature_reqs_all = linked_needs(feature_id, "satisfied_by_back")
     |selectattr("type", "eq", "feat_req")
     |list %}
{% set ns = namespace(reqs=[]) %}
{% for req in feature_reqs_all %}
{% if req_in_report_version(req, report_version) %}
{% set ns.reqs = ns.reqs + [req] %}
{% endif %}
{% endfor %}
{% set feature_reqs = ns.reqs %}
{% set feature_req_ids = feature_reqs|map(attribute="id")|list %}
{% set feature_req_filter = 'id in ' ~ id_filter_list(feature_req_ids) %}
{#- Reference coverage: partition this Feature's in-scope requirements against
    the index built once above. -#}
{% set ns_feat_ref = split_by_reference(feature_req_ids, comp_referenced_ids) %}
{#- ``type`` has no "in" test in minijinja, so the two architecture types are
    collected separately and concatenated. -#}
{% set feature_arcs_all = linked_needs(feature_id, "belongs_to_back") %}
{% set feature_arcs = (feature_arcs_all|selectattr("type", "eq", "feat_arc_sta")|list)
     + (feature_arcs_all|selectattr("type", "eq", "feat_arc_dyn")|list) %}
Requirements Statistics
^^^^^^^^^^^^^^^^^^^^^^^
{% set req_base = 'type == "feat_req" and "' ~ feature_id ~ '" in satisfied_by and ' ~ feature_req_filter %}
{% set feat_asil = feature_reqs|selectattr("safety", "eq", "ASIL_B")|list %}
{% set feat_qm = feature_reqs|selectattr("safety", "eq", "QM")|list %}
{% set feat_asil_ref = split_by_reference(feat_asil|map(attribute="id")|list, comp_referenced_ids) %}
{% set feat_qm_ref = split_by_reference(feat_qm|map(attribute="id")|list, comp_referenced_ids) %}
{{ safety_pie_row(feature_title, "Requirements", req_base, "ASIL_B", "ASIL B",
     feat_asil|length, true, feat_asil_ref.referenced, feat_asil_ref.missing) }}
{{ safety_pie_row(feature_title, "Requirements", req_base, "QM", "QM",
     feat_qm|length, true, feat_qm_ref.referenced, feat_qm_ref.missing) }}

.. dropdown:: Show requirements table
   :animate: fade-in

   .. needtable::
      :filter: type == "feat_req" and "{{ feature_id }}" in satisfied_by and {{ feature_req_filter }}
      :style: table
      :columns: id;title;safety;status;testlink
      :colwidths: 13,22,8,10,47
      :sort: safety
{% if ns_feat_ref.missing %}

.. dropdown:: Not referenced by component requirements ({{ ns_feat_ref.missing|length }})
   :animate: fade-in
   :color: warning

   .. needtable::
      :filter: id in {{ id_filter_list(ns_feat_ref.missing) }}
      :style: table
      :columns: id;title;safety;status
      :colwidths: 15,45,15,25
      :sort: safety
{% endif %}

Architecture Statistics
^^^^^^^^^^^^^^^^^^^^^^^
{% set arc_base = 'type in ["feat_arc_sta", "feat_arc_dyn"] and "' ~ feature_id ~ '" in belongs_to' %}
{{ safety_pie_row(feature_title, "Architecture Elements", arc_base, "ASIL_B", "ASIL B",
     feature_arcs|selectattr("safety", "eq", "ASIL_B")|list|length, false, [], []) }}
{{ safety_pie_row(feature_title, "Architecture Elements", arc_base, "QM", "QM",
     feature_arcs|selectattr("safety", "eq", "QM")|list|length, false, [], []) }}

.. dropdown:: Show architectural elements table
   :animate: fade-in

   .. needtable::
      :filter: type in ["feat_arc_sta", "feat_arc_dyn"] and "{{ feature_id }}" in belongs_to
      :style: table
      :columns: id;title;safety;status;tags
      :colwidths: 25,30,10,15,20
      :sort: safety

Inspection Statistics
^^^^^^^^^^^^^^^^^^^^^

Presence of the feature-level inspection work products.

.. dropdown:: Show work products table
   :animate: fade-in

   .. list-table::
      :header-rows: 1
      :widths: 30 25 25 20
      :class: wp-doc-table

      * - Work Product
        - Kind
        - Realized by
        - Status
{{ workproduct_rows(feature_slug_norm, feature_workproducts) }}
{% endfor %}
