# Keep src/requirements.txt and src/requirements_py314.txt in lockstep.
# Regenerate BOTH lockfiles whenever this file or a pinned dependency changes:
#   bazel run //src:requirements.update
#   bazel run --@rules_python//python/config_settings:python_version=3.14 //src:requirements_py314.update

# Hint: Sphinx 9.2.0 dropped support for Python 3.12
Sphinx

# Sphinx-Needs 9.x is a breaking release.
# Sphinx-Needs 8.x pins its heavier transitive dependencies:
#   minijinja 3.x needs Sphinx-Needs 9
#   jsonschema-rs 0.53+ needs Sphinx-Needs 9
sphinx-needs[plotting]<10
sphinxcontrib-plantuml
pydata-sphinx-theme
sphinx-design
sphinx-autobuild
ruamel.yaml
myst-parser
PyGithub
sphinxcontrib.mermaid

# Although not required in all targets, we want pytest within ide_support to run tests from the IDE.
debugpy
rich

# write out dynamically assembled Sphinx-Needs configuration in TOML format
needs-config-writer
# use this for a specific commit for fast development iterations
# needs-config-writer @ https://github.com/useblocks/needs-config-writer/archive/032a5f8.zip

# Mount external source trees into the Sphinx project without copying.
# sphinx-mounts 0.3.0 adds a new 'ub-project' dependency, so keep 0.2.x until
# the Sphinx-Needs 9 migration (which brings the same dependency family) lands.
sphinx-mounts<0.4

# Need this to enable non bazel execution
bazel-runfiles

# Local development
pytest
pyfakefs
basedpyright
