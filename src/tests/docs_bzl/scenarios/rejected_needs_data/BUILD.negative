load("//:docs.bzl", "docs")

# Needs inventories are no longer accepted through ``docs(data = [...])``.
# Loading this package fails, so the BUILD file is kept as ``BUILD.negative``
# and only installed while test_rejected_needs_data.py runs. That keeps the
# package hidden from recursive patterns such as ``bazel test //...``.
docs(
    data = [
        "//src/tests/docs_bzl/scenarios/reference_integration/score_platform:needs_json_file",
    ],
    project = "Rejected Needs Data Input",
    project_url = "https://example.invalid/rejected-needs-data-input",
    source_dir = "docs",
)
