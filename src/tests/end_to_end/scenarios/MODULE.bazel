# A consumer of docs-as-code, used by the end_to_end scenario tests. Its
# scenarios see docs-as-code the way a real project does: through
# @score_docs_as_code and under their own module name.
module(name = "score_scenarios")

bazel_dep(name = "rules_python", version = "1.8.5")

DEFAULT_PYTHON_VERSION = "3.12"

ADDITIONAL_PYTHON_VERSION = "3.14"

# Same toolchains as docs-as-code's own MODULE.bazel.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = DEFAULT_PYTHON_VERSION,
)
python.toolchain(
    configure_coverage_tool = True,
    is_default = False,
    python_version = ADDITIONAL_PYTHON_VERSION,
)

# py_binary in the nested_bundles scenario. Same version as docs-as-code uses.
bazel_dep(name = "aspect_rules_py", version = "1.4.0")

# Mounted by the external_bundle scenario. Same version as docs-as-code uses.
bazel_dep(name = "score_process_description", version = "2.2.5")
bazel_dep(name = "score_docs_as_code", version = "0.0.0")
local_path_override(
    module_name = "score_docs_as_code",
    path = "../../../..",
)

# A second documentation module, mounted by the tool_qualification_report
# scenario. Its directory is listed in .bazelignore, so it exists only as this
# external module and not also as packages of score_scenarios.
bazel_dep(name = "score_tool_report_mounted", version = "0.0.0")
local_path_override(
    module_name = "score_tool_report_mounted",
    path = "tool_qualification_report/mounted_module",
)
